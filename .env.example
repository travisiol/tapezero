# TAPEZERO — server-side configuration. Never expose these values to the browser.

# Solana JSON-RPC. The public endpoints work without a key but fall behind (see README → Sources).
# A dedicated provider URL (Helius, Triton, QuickNode…) may embed an API key: keep it here only.
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Max RPC calls per second used by the worker for backfill, and by the API for funding lookups.
RPC_MAX_RPS=4
API_RPC_MAX_RPS=2

# 1 = subscribe to the whole PumpSwap program (needs a dedicated RPC). Default: only pools of tracked launches.
PUMPSWAP_FULL=0

# Dated SOL/USD reference used for FDV (sampled every 60 s). Any JSON with data.amount, price or solana.usd.
SOL_USD_URL=https://api.coinbase.com/v2/prices/SOL-USD/spot

# Storage (SQLite, WAL). Production: same schema on PostgreSQL.
TAPEZERO_DB=data/tapezero.db
RETENTION_HOURS=48
MAX_TRACKED_MINTS=20000

# API / static server
PORT=8790
STATIC_DIR=dist

# Film rendering on Windows when the project path is long (MAX_PATH): path to a copy of chrome-headless-shell.exe
# REMOTION_BROWSER_EXECUTABLE=C:/tools/chs/chrome-headless-shell.exe
